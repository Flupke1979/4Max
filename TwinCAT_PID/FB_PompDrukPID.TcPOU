<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.0">
  <POU Name="FB_PompDrukPID" Id="{a1b2c3d4-e5f6-7890-abcd-ef1234567890}" SpecialFunc="None">
    <Declaration><![CDATA[
(*
  FB_PompDrukPID
  ==============
  PI(D) regelaar voor pompdrukregeling in TwinCAT 3.

  Regelstrategie:
    - P : Proportioneel — directe reactie op afwijking
    - I : Integraal     — elimineert blijvende afwijking (steady-state error)
    - D : Differentieel — standaard UIT (Td = 0). Versterkt ruis, niet aanbevolen.

  Bumpless transfer:
    Bij inschakelen en bij reset wordt het integraal voorgeladen zodat de
    uitgang vloeiend start op 0 zonder schok.

  Setpoint ramp:
    rSpRamp [bar/s] begrenst hoe snel het interne setpoint mag wijzigen.
    Voorkomt P-piek bij grote setpointsprongen. 0.0 = uitgeschakeld.

  Doodband:
    Soft doodband ±rDoodband [bar] rondom setpoint: fout = 0 in de zone,
    buiten de zone wordt de doodband afgetrokken (vloeiende overgang).
    0.0 = uitgeschakeld.

  Hysterese op aan/uit schakeldrempel:
    Pomp UIT als PID-uitgang < rUitMin.
    Pomp AAN pas als PID-uitgang >= rUitMin + rHysterese.
    Voorkomt pulsen bij overshoot terugkeer naar setpoint.

  Minimale aanlooptijd (rMinAanTijd):
    Pomp blijft minimaal rMinAanTijd seconden aan na elke start.
    Voorkomt onmiddellijk uitschakelen bij druksprong of overshoot.
    Integraal accumuleert niet negatief tijdens aanlooptijd (anti-windup).
    0.0 = uitgeschakeld.

  Minimum looptijd op minimum (rMinLooptijd):
    Als pomp langer dan rMinLooptijd [s] op minimum draait, geforceerd UIT.
    Herstart als druk daalt onder setpoint - rDoodband.
    Bij herstart wordt integraal direct voorgeladen voor rUitMin + rHysterese
    zodat de pomp onmiddellijk inschakelt (geen vertraging).
    0.0 = uitgeschakeld.

  Anti-windup:
    Blokkeert negatieve integratie als pomp uit is, in hysteresezone of
    in de minimale aanlooptijd. Blokkeert positieve integratie bij maximum.

  Parameters:
    bEnable        : PID actief. Bij FALSE: uitgang = 0, bumpless tracking.
    rSetpoint      : Gewenste druk [bar]
    rMeting        : Gemeten druk van sensor [bar]
    rKp            : Proportionele versterking [-]
    rTi            : Integratietijd [s]  — 0.0 = uitgeschakeld
    rTd            : Differentiatietijd [s] — 0.0 = uitgeschakeld (aanbevolen)
    rSpRamp        : Max setpointwijziging [bar/s] — 0.0 = uitgeschakeld
    rDoodband      : Doodband rondom setpoint [bar] — 0.0 = uitgeschakeld
    rUitMin        : Minimale pompuitgang als pomp loopt [%]
    rUitMax        : Maximale pompuitgang [%]
    rHysterese     : Hysterese boven rUitMin voor inschakelen [%]
    rMinAanTijd    : Minimale aanlooptijd na elke start [s] — 0.0 = uitgeschakeld
    rMinLooptijd   : Max tijd op minimum voor geforceerde stop [s] — 0.0 = uitgeschakeld
    rCyclustijd    : PLC taskperiode [s]
    bReset         : Stijgende flank: bumpless reset naar 0
*)
FUNCTION_BLOCK FB_PompDrukPID
VAR_INPUT
    bEnable        : BOOL;                // PID inschakelen
    rSetpoint      : REAL;                // Gewenste druk [bar]
    rMeting        : REAL;                // Gemeten druk [bar]
    rKp            : REAL := 5.0;         // Proportionele versterking [-]
    rTi            : REAL := 2.0;         // Integratietijd [s]  (0 = I uit)
    rTd            : REAL := 0.0;         // Differentiatietijd [s] (0 = D uit, aanbevolen)
    rSpRamp        : REAL := 0.0;         // Max setpointwijziging [bar/s] (0 = uit)
    rDoodband      : REAL := 0.0;         // Doodband rondom setpoint [bar] (0 = uit)
    rUitMin        : REAL := 0.0;         // Minimum pompuitgang als pomp loopt [%]
    rUitMax        : REAL := 100.0;       // Maximum pompuitgang [%]
    rHysterese     : REAL := 5.0;         // Hysterese boven rUitMin voor inschakelen [%]
    rMinAanTijd    : REAL := 5.0;         // Minimale aanlooptijd na start [s] (0 = uit)
    rMinLooptijd   : REAL := 0.0;         // Max tijd op minimum voor stop [s] (0 = uit)
    rCyclustijd    : REAL := 0.01;        // Taskperiode [s]
    bReset         : BOOL;                // Bumpless reset naar 0
END_VAR
VAR_OUTPUT
    rUitgang         : REAL;              // Pompuitgang [%]  (0 of rUitMin..rUitMax)
    bPompLoopt       : BOOL;              // TRUE = pomp draait
    bOpMinimum       : BOOL;              // TRUE = pomp draait op minimum
    bWachtOpDrukval  : BOOL;              // TRUE = geforceerd uit, wacht op drukdaling
    rTellerAan       : REAL;              // Timer: huidige looptijd na laatste start [s]
    rTellerMin       : REAL;              // Timer: tijd op minimum [s]
    rSetpointActief  : REAL;              // Intern (gerampte) setpoint [bar]
    rAfwijking       : REAL;              // Regelafwijking: setpoint - meting [bar]
    rAfwijkingActief : REAL;              // Afwijking na doodband verwerking [bar]
    rPDeel           : REAL;              // P-bijdrage [%]
    rIDeel           : REAL;              // I-bijdrage [%]
    rDDeel           : REAL;              // D-bijdrage [%]
    bMaxBegrensd     : BOOL;              // Uitgang begrensd op maximum
END_VAR
VAR
    rIntegraal       : REAL;              // Integraalsom
    rMetingVorig     : REAL;              // Meting vorige cyclus (voor D op meting)
    rUitOngeclipped  : REAL;              // PID som voor begrenzing
    bResetVorig      : BOOL;              // Flankdetectie reset
    rSpIntern        : REAL;              // Gerampte setpoint intern
    bEersteRun       : BOOL := TRUE;      // Initialisatie eerste scan
    bMinAanTijdActief : BOOL;             // Aanlooptijd actief vorige cyclus (voor anti-windup)
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[
// --- Initialisatie eerste scan ---
IF bEersteRun THEN
    rSpIntern    := rSetpoint;
    rMetingVorig := rMeting;
    bEersteRun   := FALSE;
END_IF

// --- Veiligheidscontrole parameters ---
IF rCyclustijd <= 0.0  THEN rCyclustijd  := 0.01; END_IF
IF rUitMax <= rUitMin  THEN rUitMax      := rUitMin + 1.0; END_IF
IF rHysterese < 0.0    THEN rHysterese   := 0.0; END_IF
IF rDoodband < 0.0     THEN rDoodband    := 0.0; END_IF
IF rMinLooptijd < 0.0  THEN rMinLooptijd := 0.0; END_IF
IF rMinAanTijd < 0.0   THEN rMinAanTijd  := 0.0; END_IF

// --- Setpoint ramp ---
IF rSpRamp > 0.0 THEN
    IF rSetpoint > rSpIntern + rSpRamp * rCyclustijd THEN
        rSpIntern := rSpIntern + rSpRamp * rCyclustijd;
    ELSIF rSetpoint < rSpIntern - rSpRamp * rCyclustijd THEN
        rSpIntern := rSpIntern - rSpRamp * rCyclustijd;
    ELSE
        rSpIntern := rSetpoint;
    END_IF
ELSE
    rSpIntern := rSetpoint;
END_IF
rSetpointActief := rSpIntern;

// --- Regelafwijking ---
rAfwijking := rSpIntern - rMeting;

// --- Doodband (soft) ---
IF rDoodband > 0.0 THEN
    IF ABS(rAfwijking) < rDoodband THEN
        rAfwijkingActief := 0.0;
    ELSIF rAfwijking > 0.0 THEN
        rAfwijkingActief := rAfwijking - rDoodband;
    ELSE
        rAfwijkingActief := rAfwijking + rDoodband;
    END_IF
ELSE
    rAfwijkingActief := rAfwijking;
END_IF

// P-term (ook nodig voor bumpless preload berekeningen)
rPDeel := rKp * rAfwijkingActief;

// --- Bumpless reset op stijgende flank ---
IF bReset AND NOT bResetVorig THEN
    IF rTi > 0.0 AND rKp > 0.0 THEN
        // Druk onder setpoint: direct voorladen voor snelle start
        // Druk op/boven setpoint: voorladen voor 0 (geen directe start)
        IF rAfwijkingActief > 0.0 THEN
            rIntegraal := (rUitMin + rHysterese - rPDeel) * rTi / rKp;
        ELSE
            rIntegraal := (0.0 - rPDeel) * rTi / rKp;
        END_IF
    ELSE
        rIntegraal := 0.0;
    END_IF
    rMetingVorig     := rMeting;
    bPompLoopt       := FALSE;
    bWachtOpDrukval  := FALSE;
    rTellerMin       := 0.0;
    rTellerAan       := 0.0;
    bMinAanTijdActief := FALSE;
END_IF
bResetVorig := bReset;

// --- PID inactief: uitgang = 0, integraal tracken voor bumpless inschakelen ---
IF NOT bEnable THEN
    rSpIntern         := rSetpoint;
    rSetpointActief   := rSpIntern;

    IF rTi > 0.0 AND rKp > 0.0 THEN
        IF rAfwijkingActief > 0.0 THEN
            rIntegraal := (rUitMin + rHysterese - rPDeel) * rTi / rKp;
        ELSE
            rIntegraal := (0.0 - rPDeel) * rTi / rKp;
        END_IF
    ELSE
        rIntegraal := 0.0;
    END_IF
    rMetingVorig      := rMeting;
    bPompLoopt        := FALSE;
    bWachtOpDrukval   := FALSE;
    rTellerMin        := 0.0;
    rTellerAan        := 0.0;
    bMinAanTijdActief := FALSE;

    rUitgang          := 0.0;
    bOpMinimum        := FALSE;
    rIDeel            := 0.0;
    rDDeel            := 0.0;
    bMaxBegrensd      := FALSE;
    RETURN;
END_IF

// --- I-deel met anti-windup ---
// Blokkeert negatieve integratie als:
//   - pomp uit is (incl. hysteresezone)
//   - minimale aanlooptijd actief is (druksprong → niet negatief integreren)
//   - wachttoestand na min-looptijd
// Blokkeert positieve integratie als maximum bereikt is
IF rTi > 0.0 THEN
    IF NOT (bMaxBegrensd AND rAfwijkingActief > 0.0)
    AND NOT ((NOT bPompLoopt OR bMinAanTijdActief OR bWachtOpDrukval)
             AND rAfwijkingActief < 0.0) THEN
        rIntegraal := rIntegraal + rAfwijkingActief * rCyclustijd;
    END_IF
    rIDeel := (rKp / rTi) * rIntegraal;
ELSE
    rIntegraal := 0.0;
    rIDeel     := 0.0;
END_IF

// Pomp uit maar druk onder setpoint: integraal direct voorladen voor snelle start.
// Voorkomt 100-500s wachttijd bij kleine afwijking buiten doodband.
IF NOT bPompLoopt AND NOT bWachtOpDrukval AND rAfwijkingActief > 0.0
   AND rTi > 0.0 AND rKp > 0.0 THEN
    rIntegraal := MAX(rIntegraal, (rUitMin + rHysterese - rPDeel) * rTi / rKp);
    rIDeel     := (rKp / rTi) * rIntegraal;
END_IF

// --- D-deel op meting (geen D-kick bij setpointwijziging) ---
IF rTd > 0.0 THEN
    rDDeel := -rKp * rTd * (rMeting - rMetingVorig) / rCyclustijd;
ELSE
    rDDeel := 0.0;
END_IF
rMetingVorig := rMeting;

// --- PID som ---
rUitOngeclipped := rPDeel + rIDeel + rDDeel;
bMaxBegrensd    := rUitOngeclipped > rUitMax;

// --- Uitgang met hysterese op inschakelpunt ---
//   UIT -> AAN : PID-uitgang >= rUitMin + rHysterese
//   AAN -> UIT : PID-uitgang < rUitMin
IF rUitOngeclipped < rUitMin THEN
    rUitgang   := 0.0;
    bPompLoopt := FALSE;
ELSIF NOT bPompLoopt AND rUitOngeclipped < rUitMin + rHysterese THEN
    rUitgang   := 0.0;
    bPompLoopt := FALSE;
ELSIF bMaxBegrensd THEN
    rUitgang   := rUitMax;
    bPompLoopt := TRUE;
ELSE
    rUitgang   := rUitOngeclipped;
    bPompLoopt := TRUE;
END_IF

// --- Minimale aanlooptijd: pomp blijft aan na elke start ---
// Voorkomt onmiddellijk uitschakelen bij druksprong of transient.
// Uitgang wordt op rUitMin geklemd als PID lager wil gaan.
IF rMinAanTijd > 0.0 AND rTellerAan > 0.0 AND rTellerAan < rMinAanTijd THEN
    bMinAanTijdActief := TRUE;
    IF NOT bPompLoopt THEN
        rUitgang   := rUitMin;
        bPompLoopt := TRUE;
    END_IF
ELSE
    bMinAanTijdActief := FALSE;
END_IF

// Update aanlooptimer (reset bij stilstand, telt bij draaien)
IF bPompLoopt THEN
    rTellerAan := rTellerAan + rCyclustijd;
ELSE
    rTellerAan := 0.0;
END_IF

// --- Minimum looptijd op minimum: geforceerde stop en herstart ---
bOpMinimum := bPompLoopt AND (rUitOngeclipped < rUitMin + rHysterese);

IF rMinLooptijd > 0.0 THEN
    IF bWachtOpDrukval THEN
        IF rMeting < rSpIntern - rDoodband THEN
            // Herstart: integraal voorladen voor DIRECTE start (geen vertraging)
            // P + I = rUitMin + rHysterese zodat pomp onmiddellijk inschakelt
            IF rTi > 0.0 AND rKp > 0.0 THEN
                rIntegraal := (rUitMin + rHysterese - rPDeel) * rTi / rKp;
            ELSE
                rIntegraal := rUitMin + rHysterese;
            END_IF
            bWachtOpDrukval := FALSE;
            rTellerMin      := 0.0;
        ELSE
            // Geforceerd uitgeschakeld: overschrijf uitgang
            rUitgang          := 0.0;
            bPompLoopt        := FALSE;
            rTellerAan        := 0.0;
            bMinAanTijdActief := FALSE;
            IF rTi > 0.0 AND rKp > 0.0 THEN
                rIntegraal := (0.0 - rPDeel) * rTi / rKp;
            END_IF
        END_IF

    ELSIF bOpMinimum THEN
        rTellerMin := rTellerMin + rCyclustijd;
        IF rTellerMin >= rMinLooptijd THEN
            bWachtOpDrukval := TRUE;
            rTellerMin      := 0.0;
        END_IF

    ELSE
        rTellerMin := 0.0;
    END_IF
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
